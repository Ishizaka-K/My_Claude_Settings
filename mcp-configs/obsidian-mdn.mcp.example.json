{
  "mcpServers": {
    "obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "<obsidian-mcp-server-package>"
      ],
      "env": {
        "OBSIDIAN_VAULT_PATH": "<absolute-path-to-your-obsidian-vault>",
        "OBSIDIAN_API_KEY": "<optional-local-rest-api-key-if-required>"
      }
    },
    "mdn": {
      "command": "npx",
      "args": [
        "-y",
        "<mdn-mcp-server-package>"
      ],
      "env": {}
    }
  }
}
